{
  "name": "dsh-freecad",
  "version": "0.2.1",
  "description": "DSH plugin for FreeCAD: inspect and edit STEP/STP solid models, then generate first-angle 2D machining drawings (SVG/DXF/PDF/PNG) with automatic HLR, dimensions and a hole table.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node index.js --self-test",
    "package": "node scripts/package.mjs"
  },
  "author": "蓝色大肥鱼",
  "files": [
    "INSTALL-FOR-AI.md",
    "index.js",
    "lib/",
    "dsh/",
    "examples/",
    "scripts/",
    "docs/",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "freecad",
    "step",
    "stp",
    "cad",
    "cam",
    "dxf",
    "techdraw"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
