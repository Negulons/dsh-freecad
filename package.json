{
  "name": "dsh-freecad",
  "version": "0.3.0",
  "description": "DSH plugin for FreeCAD: inspect and edit STEP/STP solid models, then generate first-angle 2D machining drawings (SVG/DXF/PDF/PNG) with automatic HLR, dimensions and a hole table.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Negulons/dsh-freecad.git"
  },
  "homepage": "https://github.com/Negulons/dsh-freecad#readme",
  "bugs": {
    "url": "https://github.com/Negulons/dsh-freecad/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/Negulons"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node tests/test_host.mjs && python tests/test_renderer.py",
    "package": "node scripts/package.mjs",
    "test:host": "node tests/test_host.mjs"
  },
  "author": "蓝色大肥鱼",
  "files": [
    "INSTALL-FOR-AI.md",
    "index.js",
    "lib/",
    "dsh/",
    "examples/",
    "scripts/",
    "docs/",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "tests/"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "freecad",
    "step",
    "stp",
    "cad",
    "cam",
    "dxf",
    "techdraw"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
